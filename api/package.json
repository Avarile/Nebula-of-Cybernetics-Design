{
  "name": "cybernetics",
  "version": "0.0.1",
  "description": "Cybernetics — modular NestJS application",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ]
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "check:graph": "ts-node -r tsconfig-paths/register src/scripts/check-module-graph.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:graph",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/database/seeders/seed.ts",
    "reconcile:balances": "ts-node -r tsconfig-paths/register src/scripts/reconcile-balances.ts",
    "repair:orphans": "ts-node -r tsconfig-paths/register src/scripts/repair-orphaned-rows.ts",
    "storage:init": "ts-node -r tsconfig-paths/register src/infrastructure/file-manage/scripts/init-minio.ts",
    "test:api": "ts-node -r tsconfig-paths/register test/api-suite/index.ts",
    "data:gen": "ts-node -r tsconfig-paths/register test/data-gen/index.ts",
    "data:coverage": "ts-node -r tsconfig-paths/register test/data-gen/coverage.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.20",
    "@keyv/redis": "^5.1.6",
    "@mastra/core": "^1.50.1",
    "@mastra/memory": "^1.23.0",
    "@mastra/nestjs": "^0.2.6",
    "@mastra/pg": "1.15.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@scalar/nestjs-api-reference": "1.2.11",
    "@sentry/nestjs": "^10.65.0",
    "@sentry/profiling-node": "^10.65.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.80.2",
    "cache-manager": "^7.2.9",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "imapflow": "^1.4.7",
    "ioredis": "^5.11.1",
    "keyv": "^5.6.0",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "meilisearch": "^0.45.0",
    "minio": "^8.0.7",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "5.4.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
