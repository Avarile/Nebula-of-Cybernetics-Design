# Application
NODE_ENV=development
PORT=3000
APP_NAME=cybernetics

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=cybernetics
DATABASE_SSL=false
# Verify the DB server's TLS certificate. Only disable for a self-signed dev server.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# pg pool for the WHOLE process: HTTP handlers + queue workers + Mastra's store.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# Fail rather than wait forever when the pool is saturated.
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_LOGGING=false

# Redis (shared by cache, session cache, and BullMQ)
# Run background workers and schedulers in this process. Set false on
# API-only replicas so scaling HTTP does not multiply queue consumers.
WORKER_ENABLED=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Ceiling on one Redis command, applied both by the client and by the caches
# that race it. Sized for round-trip PLUS event-loop lag: too tight and a busy
# process reports a healthy Redis as unreachable.
REDIS_COMMAND_TIMEOUT_MS=1000

# Observability (Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=info

# --- Health -----------------------------------------------------------------
# Heap ceiling past which the ADMIN health report calls the process degraded.
# Reported only: it does not fail /health/live or /health/ready, so crossing it
# cannot restart a pod or pull it from the load balancer. Default 1 GiB.
HEALTH_HEAP_THRESHOLD_BYTES=1073741824

# MinIO / object storage
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=cybernetics
MINIO_PRESIGN_EXPIRY=300          # presigned URL TTL (seconds)

# File policy
FILE_MAX_SIZE=52428800            # 50 MiB max upload
FILE_ALLOWED_MIME=                # csv allowlist; empty = allow any
FILE_PENDING_TTL=3600             # seconds before an unfinished upload is expired
# Retention for soft-deleted files before their bytes are purged.
FILE_PURGE_AFTER_DAYS=30

# MeiliSearch / search engine
MEILISEARCH_HOST=localhost
MEILISEARCH_PORT=7700
MEILISEARCH_USE_SSL=false
MEILISEARCH_MASTER_KEY=           # REQUIRED in production
MEILISEARCH_INDEX_PREFIX=         # index namespace; empty = none
# Client timeouts (ms): task = wait for index writes, search = query deadline.
MEILISEARCH_TASK_TIMEOUT_MS=10000
MEILISEARCH_SEARCH_TIMEOUT_MS=5000
SEARCH_DEFAULT_PAGE_SIZE=20       # page size when the request omits one
SEARCH_MAX_PAGE_SIZE=100          # hard cap on a requested page size
SEARCH_MAX_TOTAL_HITS=10000       # deep-pagination ceiling; must be >= MAX_PAGE_SIZE

# Search indexing pipeline (Postgres = source of truth, Meili converges async).
# The reconciliation sweep is what makes indexing at-least-once: it re-drives
# any record left PENDING/FAILED, so a lost handoff or a Meili outage repairs
# itself instead of leaving a row permanently unsearchable.
SEARCH_RECONCILE_EVERY_MS=60000   # how often the drift-repair sweep runs
SEARCH_RECONCILE_STALE_MS=300000  # unconverged for this long before a retry
SEARCH_RECONCILE_MAX_BACKOFF_MS=3600000  # retry wait doubles per failure, capped here
SEARCH_RECONCILE_BATCH=500        # records re-enqueued per sweep
SEARCH_INDEX_CONCURRENCY=4        # indexing workers; 1 serializes the pipeline
SEARCH_INDEX_BATCH_SIZE=500       # record ids per batched index job
SEARCH_MAX_INDEX_ATTEMPTS=10      # attempts past which a record is flagged stuck
SEARCH_PURGE_AFTER_DAYS=30        # retention for soft-deleted, removed records
SEARCH_PURGE_EVERY_MS=86400000    # how often the retention sweep runs
SEARCH_PURGE_BATCH=1000           # rows reclaimed per purge sweep
SEARCH_WAIT_TIMEOUT_MS=5000       # ceiling for persist's optional ?wait=true
SEARCH_LAG_ALERT_SECONDS=300      # index lag that turns /health degraded
SEARCH_REGISTRY_TTL_MS=60000      # collection-cache TTL (invalidation backstop)

# Mastra AI agent
AI_GATEWAY_API_KEY=               # AI Gateway key; REQUIRED in production
MASTRA_MODEL=anthropic/claude-sonnet-4.6
MASTRA_MAX_RETRIES=2              # retries per model call
MASTRA_MEMORY_LAST_MESSAGES=20    # history messages kept per thread
MASTRA_APPROVAL_TTL_MS=86400000   # 24h tool-approval window
MASTRA_SCHEDULES_ENABLED=false    # enable agent cron schedules
# Ceiling on one agent turn; a hung model call otherwise holds a request open.
MASTRA_RUN_TIMEOUT_MS=120000

# Auth / JWT
# Production rejects the default below and anything under 32 chars.
JWT_ACCESS_SECRET=dev-insecure-secret-change-me-please
JWT_ACCESS_TTL=900                # 15 min
JWT_REFRESH_TTL=604800            # 7 days
AGENT_TOKEN_TTL=900               # 15 min; scoped service tokens
JWT_ISSUER=cybernetics            # "iss" claim
# Verified on every token, so a token minted for another service is refused.
JWT_AUDIENCE=cybernetics-api

# Security
# Max JSON request body. Express defaults to 100kb, which is smaller than the
# record batches the search API advertises.
REQUEST_BODY_LIMIT=2mb

THROTTLE_TTL=60                   # rate-limit window (seconds)
THROTTLE_LIMIT=100                # requests per window
CORS_ORIGINS=                     # csv allowlist; empty = none

# Auth seeding
SEED_ADMIN_EMAIL=admin@cybernetics.local
SEED_ADMIN_PASSWORD=              # REQUIRED in production (>= 12 chars)

# Password reset (forgot-password OTP)
# Production rejects the default below and anything under 16 chars.
PASSWORD_RESET_PEPPER=dev-insecure-reset-pepper-change-me
# Reset-code lifetime (seconds) and wrong-guess budget before the code burns.
PASSWORD_RESET_CODE_TTL=900
PASSWORD_RESET_MAX_ATTEMPTS=5

# System module (secret encryption at rest)
# Base64 32-byte key. The default is 32 ZERO bytes and is rejected in
# production — generate a real one with: openssl rand -base64 32
SYSTEM_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SYSTEM_ENCRYPTION_KEY_VERSION=1   # bump when rotating the key
# How long a system setting stays cached (invalidated on write regardless).
SYSTEM_SETTINGS_CACHE_TTL_MS=300000

# OpenAPI / API reference docs (Scalar)
OPENAPI_ENABLED=true              # serve the API reference
OPENAPI_SERVER_URL=               # absolute base URL; empty = relative

# Mailbox ingestion
# Operational tunables read straight from process.env (outside the Zod schema),
# so a bad value falls back to the default instead of failing boot. IMAP/SMTP
# credentials are NOT env vars — they are stored encrypted via the system module.
MAILBOX_POLL_INTERVAL_MS=300000   # 5 min
MAILBOX_BATCH_CAP=200             # max messages per sync run
MAILBOX_STORE_RAW=true            # keep the original RFC822 source
MAILBOX_PUSH_FLAGS=false          # write \Seen flags back to IMAP
MAILBOX_DEFAULT_ACCOUNT_ID=       # empty = scheduled polling disabled
MAILBOX_DEFAULT_MAILBOX=INBOX     # IMAP folder to poll

# ---------------------------------------------------------------------------
# Scheduler (calendar reminders) — table + poller
# ---------------------------------------------------------------------------
# Also operational tunables read straight from process.env. The interactions
# matter more than the values:
#   - TICK_BUDGET_MS must stay BELOW TICK_INTERVAL_MS, or a backlog makes ticks
#     overlap and the poller competes with itself for the same rows.
#   - LEASE_SECONDS must EXCEED the slowest handler. Too short duplicates work;
#     too long delays recovery after a crash.
#   - CONCURRENCY is held against DATABASE_POOL_MAX. Undersize the pool and the
#     poller starves the HTTP handlers.
SCHEDULER_TICK_INTERVAL_MS=10000    # latency floor: reminders fire 0-10s late
SCHEDULER_REAP_INTERVAL_MS=60000    # how often expired leases are requeued
SCHEDULER_MATERIALIZE_CRON=0 3 * * *  # nightly recurrence expansion
SCHEDULER_LEASE_SECONDS=60
SCHEDULER_TICK_BUDGET_MS=8000
SCHEDULER_CONCURRENCY=10
SCHEDULER_BATCH_SIZE=100
SCHEDULER_HANDLER_TIMEOUT_MS=30000  # kept under the lease
SCHEDULER_MAX_ATTEMPTS=5            # counted at claim, so a poison job dies
SCHEDULER_BACKOFF_BASE_MS=30000
SCHEDULER_BACKOFF_CAP_MS=1800000
SCHEDULER_HORIZON_DAYS=90           # the knob that bounds storage
SCHEDULER_MATERIALIZE_BATCH=200
SCHEDULER_OVERDUE_ALERT_THRESHOLD=1 # overdue_5m at or above this = degraded
