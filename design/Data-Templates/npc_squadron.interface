# INTERFACE: NpcSquadron
# Source of truth : ../tools/gameplay_tables.py -> NPC_SQUADRONS, RESPONSE_FLEET, BOUNTY_RATE
# Spec            : ../GamePlay/conflict_specification.md 2-3
# Generated by    : ../tools/generate_npc.py -- deterministic, no RNG.
# Live reference  : ../fleet_and_weapons.json -> "npcSquadrons"
#                   ../tools/verify_npc.py checks the invariants below.
#
# [+] No upstream counterpart; new in full.
#
# A squadron is a COMPOSITION, not a stat block. Every entry names a real shipId in
# the ship catalogue, so an NPC hull is exactly the hull a player would fly, fitted
# the same way, and its value falls out of the buildCost that hull already carries.
# Nothing about an NPC is authored except which hulls and how many.
#
# TWO KINDS:
#   squadron       spawns by security tier and is hostile to players. None in core.
#   responseFleet  the NPC military answer to aggression in core or mid. Must beat
#                  the richest fleet ONE player can field -- fleetSlots copies of the
#                  dearest hull in the catalogue (370,013 cr today). verify_npc.py
#                  recomputes that bar and fails the build if a fleet falls under it.
#                  fleetSlots is counted from skl_flt_formation_drill's unlocks; per
#                  gameplay_specification.md 6.6 no schema may state 5 as a cap.
#
# BOUNTY is referenceValue x BOUNTY_RATE[tier] -- 0.00 core, 0.05 mid, 0.10 rim,
# 0.18 deadspace. expectedSalvage is the FIT only, at SALVAGE_DROP 0.50, which is
# why killing light hulls pays proportionally better: a hull's fit share runs from
# 84% on a motor torpedo boat to 10% on a battleship.
#
# INVARIANTS (enforced by tools/verify_npc.py)
#   - every shipId resolves in the live ship catalogue
#   - referenceValue rises strictly as security falls, across all templates
#   - no squadron has securityTier core
#   - every response fleet outvalues fleetSlots copies of the dearest hull
#   - securityTier is one of the four in systems_planets_specification.md 3

{
  "squadronId": "string, unique, format: npc_<tier>_<slug>",
  "name": "string",
  "securityTier": "enum: mid | rim | deadspace   (never core -- nothing hostile spawns there)",
  "hullCount": "integer -- sum of counts below",
  "hulls": "array of { shipId, name, shipClass, count, unitReferencePrice }",
  "referenceValue": "number, credits -- sum of unitReferencePrice x count",
  "bountyRate": "number -- BOUNTY_RATE for this securityTier",
  "bounty": "number, credits -- referenceValue x bountyRate, paid in phase 13",
  "expectedSalvage": "number, credits -- sum of each hull's fitPrice x count x SALVAGE_DROP"
}

# ---- EXAMPLE INSTANCE ----
#
# {
#   "squadronId": "npc_dead_warband", "name": "Deadspace Warband",
#   "securityTier": "deadspace", "hullCount": 5,
#   "hulls": [
#     { "shipId": "ship_heavy_cruiser_t3", "name": "Heavy Cruiser Tier 3",
#       "shipClass": "heavy_cruiser", "count": 4, "unitReferencePrice": 26556.15 },
#     { "shipId": "ship_battlecruiser_t3", "name": "Battlecruiser Tier 3",
#       "shipClass": "battlecruiser", "count": 1, "unitReferencePrice": 55439.34 }
#   ],
#   "referenceValue": 161663.94, "bountyRate": 0.18, "bounty": 29099.51,
#   "expectedSalvage": 13158.72
# }
