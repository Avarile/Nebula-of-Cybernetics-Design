# INTERFACE: Contract
# Source of truth : ../tools/gameplay_tables.py -> CONTRACT_ARCHETYPES, RISK_INDEX
# Spec            : ../GamePlay/economy_specification.md 8
# Generated by    : ../tools/generate_npc.py -- deterministic, no RNG.
# Live reference  : ../fleet_and_weapons.json -> "contractArchetypes"
#
# [+] No upstream counterpart; new in full.
#
# TWO SHAPES:
#   archetype   GENERATED. Four of them, each a job description plus the formula its
#               reward is computed from. Parameters, not instances.
#   contract    RUNTIME. One posted job, by an NPC or a player.
#
# COLLATERAL -- a player-posted contract holds the poster's credits at posting and
# releases them on completion or expiry. There is no unsecured promise, so a
# contract cannot create credits from nothing. NPC-posted contracts are a faucet and
# are listed as one in economy_specification.md 7.
#
# WHY ESCORT EXISTS -- six hull categories can carry cargo and none of them can
# fight (logistics_specification.md 3). A contract that pays combat players to
# protect industrial ones is what connects the two careers without forcing either to
# train the other's skills.
#
# INVARIANTS (enforced by tools/verify_market.py)
#   - every archetype's reward formula names only stats and constants that exist
#   - riskIndex covers all four security tiers and rises as security falls
#   - a player-posted contract's collateral is >= its reward

{
  "archetype": {
    "contractId": "string, unique, format: ctr_<slug>",
    "name": "string",
    "job": "string -- what the acceptor must do",
    "rewardFormula": "string -- pseudocode over reference values, distance and risk",
    "riskIndex": "object: securityTier -> number, rising as security falls"
  },

  "contract": {
    "instanceId": "string, unique",
    "contractId": "the archetype this instantiates",
    "postedBy": "playerId | unionId | 'npc'",
    "postedTurn": "integer",
    "expiresTurn": "integer",
    "acceptedBy": "playerId | unionId | null",
    "parameters": "object -- shape determined by the archetype (goodId, quantity, fromSystemId, toSystemId, squadronId, ...)",
    "reward": "number, credits",
    "collateral": "number, credits -- held from the poster; equals reward for player-posted, 0 for npc",
    "status": "enum: open | accepted | completed | expired | failed"
  }
}

# ---- EXAMPLE INSTANCES ----
#
# archetype:
# { "contractId": "ctr_escort", "name": "Escort",
#   "job": "accompany a fleet across a route without it being destroyed",
#   "rewardFormula": "routeDistanceLy * escortedCargoValue",
#   "riskIndex": { "core": 1.0, "mid": 1.15, "rim": 1.45, "deadspace": 1.9 } }
#
# contract:
# { "instanceId": "ctx_00291", "contractId": "ctr_haul", "postedBy": "uni_0007",
#   "postedTurn": 47, "expiresTurn": 57, "acceptedBy": null,
#   "parameters": { "goodId": "res_raw_isotopes", "quantity": 4000,
#                   "fromSystemId": "sys_052", "toSystemId": "sys_003" },
#   "reward": 41200.0, "collateral": 41200.0, "status": "open" }
