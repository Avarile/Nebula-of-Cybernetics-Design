# INTERFACE: Contract
# Source of truth : ../tools/gameplay_tables.py -> CONTRACT_ARCHETYPES, RISK_INDEX,
#                   HAUL_FREIGHT_RATE, HAUL_RISK_RATE, ESCORT_SHARE, ESCORT_BOND
# Spec            : ../GamePlay/economy_specification.md 8
# Generated by    : ../tools/generate_npc.py -- deterministic, no RNG.
# Live reference  : ../fleet_and_weapons.json -> "contractArchetypes"
#
# [+] No upstream counterpart; new in full.
# [+] archetype.posters -- who may post it. ctr_escort is player-only: the escorted party
#     hires its own escort, so no stranger is put inside a convoy by an NPC
#     (economy_specification.md 8.2).
# [+] contract.acceptorCollateral -- credits held from the ACCEPTOR. A haul's acceptor
#     posts the cargo at the dearest NPC ask for it anywhere (8.1), so keeping the cargo
#     never beats delivering it; an escort's acceptor posts ESCORT_BOND x reward, forfeited
#     only on desertion (8.2).
# [+] parameters for ctr_haul and ctr_escort are pinned below, including the route the
#     reward was priced on and its routeRiskIndex (the least secure system on it).
#
# TWO SHAPES:
#   archetype   GENERATED. Four of them, each a job description plus the formula its
#               reward is computed from. Parameters, not instances.
#   contract    RUNTIME. One posted job, by an NPC or a player.
#
# COLLATERAL -- a player-posted contract holds the poster's credits at posting and
# releases them on completion or expiry. There is no unsecured promise, so a
# contract cannot create credits from nothing. NPC-posted contracts are a faucet and
# are listed as one in economy_specification.md 7; forfeited NPC-haul collateral is a
# drain listed there too.
#
# WHY ESCORT EXISTS -- six hull categories can carry cargo and none of them can
# fight (logistics_specification.md 3). A contract that pays combat players to
# protect industrial ones is what connects the two careers without forcing either to
# train the other's skills.
#
# INVARIANTS (enforced by tools/verify_npc.py, tools/verify_market.py, tools/verify_gameplay.py)
#   - every UPPER_CASE constant an archetype's reward formula names exists in gameplay_tables.py
#   - riskIndex covers all four security tiers and rises as security falls
#   - ctr_escort is player-posted only
#   - a player-posted contract's collateral is >= its reward
#   - a haul's acceptorCollateral is >= every NPC bid and ask for the cargo, at any trade level
#   - the escort reference quote is zero exactly where PvP is blocked

{
  "archetype": {
    "contractId": "string, unique, format: ctr_<slug>",
    "name": "string",
    "job": "string -- what the acceptor must do",
    "rewardFormula": "string -- pseudocode over reference values, distance, risk and UPPER_CASE constants of gameplay_tables.py",
    "posters": "array of enum: npc | player -- [+] who may post it; ctr_escort is ['player']",
    "riskIndex": "object: securityTier -> number, rising as security falls"
  },

  "contract": {
    "instanceId": "string, unique",
    "contractId": "the archetype this instantiates",
    "postedBy": "playerId | unionId | 'npc'",
    "postedTurn": "integer",
    "expiresTurn": "integer",
    "acceptedBy": "playerId | unionId | null",
    "parameters": "object -- shape determined by the archetype; ctr_haul and ctr_escort below",
    "reward": "number, credits",
    "collateral": "number, credits -- held from the poster; equals reward for player-posted, 0 for npc",
    "acceptorCollateral": "number, credits -- [+] held from the acceptor at acceptance: cargo x the dearest NPC ask (ctr_haul), ESCORT_BOND x reward (ctr_escort), 0 otherwise",
    "status": "enum: open | accepted | completed | expired | failed"
  },

  "parameters.ctr_haul": {
    "goodId": "the good to move",
    "quantity": "integer units",
    "fromSystemId": "systemId -- A",
    "toSystemId": "systemId -- B",
    "route": "array of systemId -- the shortest route by ly, fixed at posting; the acceptor may fly another",
    "routeDistanceLy": "number",
    "routeRiskIndex": "number -- RISK_INDEX of the least secure system on route, endpoints included",
    "delivered": "integer units delivered so far -- settlement pays reward x delivered / quantity"
  },

  "parameters.ctr_escort": {
    "escortedFleetId": "fleetId -- the poster's fleet; the convoy leader",
    "escortFleetId": "fleetId or null -- named by the acceptor; linked as a follower",
    "fromSystemId": "systemId -- A",
    "toSystemId": "systemId -- B",
    "routeDistanceLy": "number",
    "routeRiskIndex": "number -- as for ctr_haul",
    "reservedFor": "playerId | unionId | null -- only this party may accept",
    "departedCargoValue": "number -- reference value of the escorted fleet's cargo when the link formed",
    "arrivedCargoValue": "number or null -- the same at B; the escort is paid reward x arrived / departed",
    "deserted": "boolean -- the escort cancelled the link before B; the bond goes to the poster"
  }
}

# ---- EXAMPLE INSTANCES ----
#
# archetype:
# { "contractId": "ctr_escort", "name": "Escort",
#   "job": "hold a convoy link to a named fleet from system A to B",
#   "rewardFormula": "escortedCargoValue * HAUL_RISK_RATE * (routeRiskIndex - 1) * ESCORT_SHARE * routeDistanceLy",
#   "posters": ["player"],
#   "riskIndex": { "core": 1.0, "mid": 1.15, "rim": 1.45, "deadspace": 1.9 } }
#
# contract:
# { "instanceId": "ctx_00291", "contractId": "ctr_haul", "postedBy": "uni_0007",
#   "postedTurn": 47, "expiresTurn": 57, "acceptedBy": "ply_0031",
#   "parameters": { "goodId": "res_raw_isotopes", "quantity": 4000,
#                   "fromSystemId": "sys_057", "toSystemId": "sys_051",
#                   "route": ["sys_057", "sys_056", "sys_051"], "routeDistanceLy": 28.3,
#                   "routeRiskIndex": 1.9, "delivered": 0 },
#   "reward": 9508.8, "collateral": 9508.8, "acceptorCollateral": 220000.0,
#   "status": "accepted" }
