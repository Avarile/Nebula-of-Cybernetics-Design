#                                      "ms_3": "mod_armour_plating_mk2" } } },
#   "rejection": null }
#   -- a Destroyer Tier 2 trading its Search Radar for an ECM Suite at the Aurelia I yard:
#   6.3 units of labour, done the same phase 6; fee 53.89 plus the suite at the NPC ask.
#
# { "orderId": "ord_00420", "turnNumber": 88, "playerId": "ply_0052",
#   "orderType": "station.deploy", "phase": 12, "submissionSequence": 2210, "standing": false,
#   "payload": { "action": "deploy", "stationTypeId": "stn_orbital_yard", "planetId": "pln_085",
#                "ownerId": "uni_0007", "kitSource": { "fleetId": "flt_0090", "hullId": "hul_0311" } },
#   "rejection": null }
#
# { "orderId": "ord_00421", "turnNumber": 88, "playerId": "ply_0031",
#   "orderType": "fleet.restock", "phase": 12, "submissionSequence": 2214, "standing": true,
#   "payload": { "fleetId": "flt_0044", "items": ["ammo", "fuel", "craft"],
#                "source": { "leaseId": "lse_0100" } },
#   "rejection": null }
#   -- a carrier group home at its own warehouse: magazines, tanks and hangars refilled every
#   phase 12 it spends there, from the charges, cores and manufactured units stored.
