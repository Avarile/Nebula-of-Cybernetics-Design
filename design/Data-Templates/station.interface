# INTERFACE: Station
# Source of truth : ../tools/gameplay_tables.py -> STATION_TYPES, STATION_FRAME_COST,
#                   STATION_SLOT_COST, the slot sizes, STATION_BERTH_RATE/TONNAGE,
#                   STATION_YIELD_MODIFIER, STATION_UPKEEP_RATE, ORBITS_PER_PLANET
# Spec            : ../GamePlay/station_specification.md
# Generated by    : ../tools/generate_stations.py -- deterministic, no RNG.
# Live reference  : ../fleet_and_weapons.json -> "stationTypes"
#                   ../tools/verify_stations.py checks the invariants below.
#
# [+] No upstream counterpart; new in full. data-template.json has no station, and the
#     map spec (Systems_Planets 10) left stations as a sibling catalogue: player-built,
#     not map-authored.
#
# TWO SHAPES, as facility.interface has:
#
#   stationType    GENERATED. One row per (stationTypeId, developmentTier): the slots
#                  the station hosts, their rent-equivalent, the upkeep, and the kit's
#                  buildCost and reference price. 4 types x 3 tiers = 12 rows.
#   station        RUNTIME. One anchored station in one planet's orbit, owned by a
#                  player or a union. Created by a station.deploy order, never generated.
#
# PROPERTY, NOT TERRITORY. A station is owned as a hull is. The planet it orbits keeps no
# owner field, its slots and the leases on them are untouched, and no faction owns a
# station. One orbit per planet (ORBITS_PER_PLANET).
#
# ITS SLOTS ARE LEASES. Anchoring creates one lease per hosted slot (facility.interface)
# with siteType "orbital" and this station's stationId. Those leases pay no rent; the
# station pays upkeep for all of them:
#     upkeepPerTurn = STATION_UPKEEP_RATE x SUM over slots ( slotCount x rentPerTurn )
# where rentPerTurn is what that slot would pay as a lease at the planet's developmentTier.
#
# NO EXTRACTION, AND NO FOURTH YIELD TERM. A station hosts refinery, manufactory,
# shipyard and warehouse slots only. A station refinery's yieldModifier REPLACES the
# planet's in conversionYield x yieldModifier x refineryYield; it never multiplies it.
#
# siteType admits "orbital". "deep_space" is reserved for the deferred deep-space stations
# (gameplay_specification.md 9) and joins the enum without any other schema change; such a
# station would carry a systemId and a null planetId.
#
# INVARIANTS (enforced by tools/verify_stations.py)
#   - slot sizes are the planet slot constants (or the station berth pair) x the
#     developmentTier multiplier; no extraction slot
#   - conversionYield x yieldModifier x refineryYield < 1 for every lane, read live
#   - a station berth never takes more tonnage than the smallest planet yard at its tier
#   - every orbit filled still holds less of each kind than the planets do
#   - upkeep per unit is never below the cheapest lease of that kind at that tier
#   - securityTiers never includes a tier where the map places no planet yard

{
  "stationType": {
    "stationTypeId": "enum: stn_orbital_depot | stn_orbital_refinery | stn_orbital_foundry | stn_orbital_yard",
    "name": "string",
    "developmentTier": "integer 1-3 -- the developmentTier of the planet orbited",
    "securityTiers": "array of enum core | mid | rim -- where a kit may be anchored; never deadspace",
    "slots": "object: facilityType -> slot row, the same shape as facilityType.slots in facility.interface",
    "slots.<key>.facilityType": "enum: refinery | manufactory | shipyard | warehouse -- never extraction",
    "slots.<key>.slotCount": "integer -- how many of this kind the station hosts",
    "slots.<key>.throughputPerTurn": "number -- per slot, at this developmentTier",
    "slots.<key>.capacity": "number -- warehouse slots only, in units",
    "slots.<key>.yieldModifier": "number <= 1.00 -- refinery slots only; STATION_YIELD_MODIFIER, scales with neither ladder",
    "slots.<key>.maxHullTonnage": "number -- shipyard slots only",
    "slots.<key>.scalesWith": "enum: developmentTier",
    "slots.<key>.unit": "string -- what throughputPerTurn counts",
    "slots.<key>.rentPerTurn": "number, credits -- what this slot would pay as a lease here; not charged",
    "upkeepPerTurn": "number, credits, charged in phase 12 -- STATION_UPKEEP_RATE x the slot rents",
    "buildCost": "object: lane -> manufactured units -- STATION_FRAME_COST + STATION_SLOT_COST per slot",
    "kitUnits": "number -- the kit's buildCost summed; its tons in a hold and its units in a warehouse",
    "referencePrice": "number, credits -- the economy 2 formula; kits are not on the NPC order books"
  },

  "station": {
    "stationId": "string, unique",
    "stationTypeId": "stationTypeId",
    "ownerId": "playerId or unionId -- whoever the deploy named",
    "siteType": "enum: orbital   ([+] deep_space reserved, not yet in use)",
    "planetId": "planetId -- the planet orbited; one of the 180",
    "startedTurn": "integer -- the turn it was anchored",
    "status": "enum: online | offline",
    "offlineSinceTurn": "integer or null -- set while upkeep is unpaid; scrapped after STATION_GRACE_TURNS",
    "upkeepPaidThroughTurn": "integer",
    "leaseIds": "array of leaseId -- one orbital lease per hosted slot"
  }
}

# ---- EXAMPLE INSTANCES ----
#
# stationType:
# { "stationTypeId": "stn_orbital_yard", "name": "Orbital Yard", "developmentTier": 2,
#   "securityTiers": ["core", "mid", "rim"],
#   "slots": { "shipyard": { "facilityType": "shipyard", "slotCount": 1,
#                            "throughputPerTurn": 18.6, "unit": "manufactured units/turn",
#                            "maxHullTonnage": 6200.0, "scalesWith": "developmentTier",
#                            "rentPerTurn": 90.15 },
#              "warehouse": { "facilityType": "warehouse", "slotCount": 1, "capacity": 930.0,
#                             "unit": "units", "scalesWith": "developmentTier",
#                             "rentPerTurn": 18.6 } },
#   "upkeepPerTurn": 108.75,
#   "buildCost": { "structural": 440.0, "energy": 70.0, "ordnance": 0.0, "precision": 40.0 },
#   "kitUnits": 550.0, "referencePrice": 15940.45 }
#
# station:
# { "stationId": "stn_0007", "stationTypeId": "stn_orbital_yard", "ownerId": "uni_0007",
#   "siteType": "orbital", "planetId": "pln_085", "startedTurn": 88, "status": "online",
#   "offlineSinceTurn": null, "upkeepPaidThroughTurn": 140,
#   "leaseIds": ["lse_0410", "lse_0411"] }
#   -- a union yard over Cindral Verge's irradiated rim world, development 2: light hulls
#   built beside the precision ore, up to 6,200 t, for 108.75 a turn.
