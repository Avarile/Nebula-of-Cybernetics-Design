# INTERFACE: Market
# Source of truth : ../tools/gameplay_tables.py -> RAW_PRICE, PRICE_INDEX, NPC_SPREAD
# Spec            : ../GamePlay/economy_specification.md
# Generated by    : ../tools/generate_market.py -- deterministic, no RNG.
# Live reference  : ../fleet_and_weapons.json -> "marketPrices"
#                   ../tools/verify_market.py checks the invariants below.
#
# [+] No upstream counterpart; new in full.
#
# TWO SHAPES:
#   priceEntry   GENERATED. One per tradeable good -- 12 resources + 1,031 weapons,
#                modules and hulls = 1,043. Derived, never authored.
#   order        RUNTIME. A player's standing buy or sell at one system.
#
# DERIVATION -- only the four RAW_PRICE anchors are authored:
#     refined      = raw     / lane.conversionYield x (1 + PROCESS_MARGIN)
#     manufactured = refined / 0.85                 x (1 + PROCESS_MARGIN)
#     item         = SUM(buildCost[lane] x manufacturedPrice[lane]) x ITEM_MARGIN
# A hull's buildCost ALREADY INCLUDES its fitted weapons and modules, so a hull's
# reference price is the fitted value and never a sum to be added to. bareHullPrice
# is referencePrice minus the fit, and is what insurance pays.
#
# THE NPC SPREAD is symmetric around the local index price:
#     halfSpread = (NPC_SPREAD / 2) x (1 - tradePriceMargin)
#     NPC sells at index x (1 + halfSpread);  NPC buys at index x (1 - halfSpread)
# Symmetry is what makes skl_trd_trade safe: narrowing the half-spread can never move
# it past the index, so a same-system round trip loses at every skill level.
#
# NPC ORDERS EXIST ONLY IN core AND mid. This is load-bearing, not flavour: at
# NPC_SPREAD 0.20 a maxed trader needs an index ratio above 1.1739 to profit on a
# haul, the worst core/mid ratio is 1.1364, and the worst all-tier ratio is 1.5625.
# Extending NPC orders past mid creates risk-free arbitrage. verify_market.py
# recomputes both numbers rather than trusting this comment.
#
# INVARIANTS (enforced by tools/verify_market.py)
#   - every one of the 1,043 goods has a strictly positive, finite reference price
#   - prices rise strictly with resource tier within a lane
#   - bareHullPrice > 0 for all 98 hulls, so insurance never pays for nothing
#   - no free money: sellerIndex/buyerIndex <= (1+halfSpread)/(1-halfSpread) for
#     every good, every NPC-order tier pair, and every level of skl_trd_trade
#   - a same-system NPC round trip loses money at every skill level
#   - market tax decreases monotonically as security falls, and is 0 in deadspace

{
  "priceEntry": {
    "goodId": "resourceId | weaponId | moduleId | shipId",
    "name": "string",
    "kind": "enum: resource | weapon | module | hull",
    "lane": "enum or null -- resources only",
    "tier": "enum raw | refined | manufactured, or null -- resources only",
    "shipClass": "enum or null -- hulls only",
    "referencePrice": "number > 0, credits",
    "bySecurityTier": "object: securityTier -> number -- resources only; referencePrice x PRICE_INDEX",
    "bareHullPrice": "number > 0 -- hulls only; referencePrice minus the fit. What insurance pays on.",
    "fitPrice": "number -- hulls only; the fitted weapons and modules",
    "fitShare": "number 0-1 -- hulls only; fitPrice / referencePrice",
    "insurance": "object: securityTier -> payout -- hulls only; bareHullPrice x INSURANCE_PAYOUT",
    "premiumPerTurn": "number -- hulls only; bareHullPrice x INSURANCE_PREMIUM",
    "expectedSalvage": "number -- hulls only; fitPrice x SALVAGE_DROP"
  },

  "order": {
    "orderId": "string, unique",
    "playerId": "playerId or unionId",
    "systemId": "systemId -- orders are per system; there is no global market",
    "goodId": "as above",
    "side": "enum: buy | sell",
    "quantity": "integer > 0 -- remaining, decremented on partial fills",
    "limitPrice": "number, credits per unit",
    "postedTurn": "integer",
    "expiresTurn": "integer or null -- null stands until filled or cancelled"
  }
}

# ---- EXAMPLE INSTANCES ----
#
# priceEntry:
# { "goodId": "ship_battleship_t3", "name": "Battleship Tier 3", "kind": "hull",
#   "shipClass": "battleship", "referencePrice": 74003.13, "bareHullPrice": 66379.47,
#   "fitPrice": 7623.66, "fitShare": 0.103,
#   "insurance": { "core": 53103.58, "mid": 46465.63, "rim": 33189.74, "deadspace": 0.0 },
#   "premiumPerTurn": 265.52, "expectedSalvage": 3811.83 }
#
# order:
# { "orderId": "mko_0812", "playerId": "ply_0031", "systemId": "sys_014",
#   "goodId": "res_mfg_guidance_assembly", "side": "sell", "quantity": 400,
#   "limitPrice": 138.0, "postedTurn": 47, "expiresTurn": null }
