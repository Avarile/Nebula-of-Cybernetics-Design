#   Refuelling Rig         cargo      specific  large     4.0   14     95  fuelTransferRate +40%
#                                                                          hulls: fleet_oiler, repair_ship_tender, seaplane_tender
#   Landing Craft Davits   cargo      specific  large     2.0   18    105  troopCapacity +35%
#                                                                          hulls: attack_transport, landing_ship_tank
#   Troop Berthing         cargo      specific  medium    2.0    6     60  troopCapacity +45%, topSpeed -2%
#                                                                          hulls: attack_transport, landing_ship_tank, merchant_raider
#
# STAT VOCABULARY -- a module effect may only target these ship stats.
#
#   topSpeed                      acceleration                  turnRate
#   evasionRating                 fuelRange                     hull.maxHP
#   hull.armorRating              hull.regenPerTurn             shields.maxHP
#   rechargeRatePerTurn           shields.rechargeDelayAfterHit power.maxPower
#   power.regenPerTurn            sensorArray.effectiveness     detectionRange
#   initiative                    weaponAccuracy                criticalChanceBonus
#   pointDefenseBonus             enemyHitChance                crew.gunnerySkill
#   crew.engineeringSkill         crew.pilotSkill               crewRecoveryRate
#   repairRatePerTurn             cargoCapacity                 ammoCapacity
#   mineCapacity                  minesweepRate                 troopCapacity
#   aircraftCapacity              droneCapacity                 medicalCapacity
#   fuelTransferRate
#
#   Negative is the benefit for: enemyHitChance, shields.rechargeDelayAfterHit.
#   A negative modifier on any other stat is a drawback (Belt Armour costs speed)
#   and shrinks as the mark rises.
# >>> end generated
#
# NOTATION
#   "string" / "number"   value type
#   "enum: a | b | c"     exactly one of the listed literals
#
# modifierType
#   "flat"    -> stat += modifier
#   "percent" -> stat *= (1 + modifier/100)   e.g. modifier 10 = +10%
#   Effects are applied to the ship stat named by the dotted path in effects[].stat.

{
  "moduleId": "string, unique, format: mod_<archetype>_mk<n>",
  "name": "string",
  "moduleType": "enum: 33 values, see the archetype table above",
  "functionClass": "[+] enum: major | support | specific",
  "slotType": "enum: engine | utility | defensive | sensor | cargo | command | hangar",
  "size": "[+] enum: small | medium | large | capital, the slot size this module needs",
  "mark": "[+] number: 1 | 2 | 3, matches the tier of the hull it is meant for",
  "mass": {
    "value": "[+] number",
    "unit": "tons"
  },
  "effects": [
    {
      "stat": "[+] string, a ship stat from the vocabulary above",
      "modifier": "number, flat or percentage per modifierType",
      "modifierType": "enum: flat | percent"
    }
  ],
  "powerCost": "number, passive power draw per turn",
  "crewRequired": "[+] number, drawn from the hull's crew complement",
  "hullAffinity": [
    "[+] array of shipClass values; non-empty for functionClass 'specific', empty otherwise"
  ],
  "buildCost": {
    "structural": "number, manufactured-tier Structural Component units",
    "energy": "number, manufactured-tier Power Core Unit units",
    "ordnance": "number, manufactured-tier Ordnance Charge units",
    "precision": "number, manufactured-tier Guidance Assembly units"
  }
}

