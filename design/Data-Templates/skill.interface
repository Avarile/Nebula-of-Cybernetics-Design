# INTERFACE: Skill
# Source of truth : ../tools/skill_tables.py -> SKILLS
# Design spec     : ../Skills/Design -- hand-written, never generated
# Live reference  : ../fleet_and_weapons.json -> "skills"
# Generated by    : ../tools/generate_skills.py -- deterministic, no RNG.
#                   Re-running reproduces the catalogue byte-for-byte. Edit the
#                   tables in skill_tables.py, never the generated files.
#                   ../tools/verify_skills.py checks the invariants below.
#
# Usage: one JSON file per skill under Skills/<domain>/<category>/; Skills/index.json
# lists all 81 with their path. Skills/Design is the hand-written spec these are derived
# from and is NOT generated output -- a generator run leaves it alone.
#
# Skills are what lets a player do anything. Every skill has 10 levels. A skill does its
# work through four lists, any of which may be empty:
#
#   effects[]        a per-level modifier on a stat (see STAT VOCABULARY below)
#   penalties[]      a flat malus that applies while the skill is BELOW a level
#   unlocks[]        a hull, fleet slot, capability or skill group that opens at a level
#   prerequisites[]  another skill that must reach a level before this one can be trained
#
# THE EFFECT FORMULA -- one rule, applied to every effect in the catalogue:
#
#     total = modifierPerLevel x max(0, level - appliesFromLevel + 1)
#
#   Navigation  (appliesFromLevel 1, +1%/level)  ->  level 10 = +10%
#   Ballistic   (appliesFromLevel 6, +5%/level)  ->  level 5 = 0, level 10 = +25%
#
# A penalty is NOT per-level: it is either on or off. `appliesBelowLevel: 5` means the
# malus applies at levels 1-4 and vanishes at 5. The four Weaponry skills pair a -50%
# damage/accuracy penalty below level 5 with an effect starting at level 6, so level 5 is
# the clean baseline -- debuff gone, bonus not yet started.
#
# OPERATING A HULL -- a hull category is operable when EVERY skill carrying an
# `unlocks[].type == "ship_operation"` for that category has reached the level stated
# there. Each of the 26 categories has exactly two such skills (Control and System
# Management) at level 5, which is the Design spec's "reaching level 5 will enable a
# player to operate that kind of ship (both control and system management is required)".
#
# TRAINING -- skill points, on EVE Online's model:
#
#     SP(level) = rank * 250 * k ** (level - 1)        k = 2 ** (10/9) ~ 2.16012
#
# `rank` is a 1-5 difficulty multiplier, derived from hull mass for ship skills and
# hand-set elsewhere. EVE runs 250 SP at level I to 256,000 at level V over FIVE levels;
# this catalogue has TEN, so k is re-derived to land on the same two endpoints rather
# than inventing a curve -- k ** 9 == 1024, so level 10 is exactly 250 * 1024 = 256,000.
#
# The `training` block publishes the numbers already multiplied by rank, so a consumer
# never re-derives them. Training TIME is rate / SP and stays a game-layer concern; at
# EVE's ~1,800 SP/hour reference a first hull is ~11 hours out and a battleship reached
# along the spine ~9 days, which is where EVE puts them.
#
# THE HULL TREE -- the 26 hulls form a prerequisite DAG rooted at `skl_fund_spaceship_command`
# (Spaceship Command). Each hull names exactly ONE predecessor and cannot be trained
# until that predecessor reaches level 5; the three entry hulls (motor torpedo boat,
# submarine chaser, corvette) sit on the root instead. Control requires the
# predecessor's Control and System Management requires the predecessor's System
# Management -- two parallel ladders that never cross, so a hull's pair rule and its
# climb rule use the same level-5 threshold.
#
#   Spaceship Command -+- Motor Torpedo Boat -- Fleet Torpedo Boat
#                      +- Submarine Chaser ---- Submarine
#                      +- Corvette -+- Landing Ship Tank -+- Attack Transport -- Fleet Oiler
#                                   |                     +- Seaplane Tender
#                                   |                     +- Repair Ship / Tender
#                                   +- Sloop / Patrol Escort -- Minelayer / Sweeper
#                                   +- Destroyer Escort -+- Anti-Aircraft Cruiser
#                                                        +- Coastal Defence -- Monitor -- Panzerschiff
#                                                        +- Destroyer -+- Merchant Raider
#                                                                      +- Light Cruiser -+- Light Carrier -- Escort Carrier -- Fleet Aircraft Carrier
#                                                                                        +- Heavy Cruiser -- Battlecruiser -- Battleship
#
# <<< generated from tools/generate_skills.py -- do not edit by hand
#
# CATALOGUE -- 81 skills, 10 levels each.
#
#   SHIP_COMMAND  (69)
#     fundamentals               1   Spaceship Command
#     ship_system_control       52   Motor Torpedo Boat Control, Motor Torpedo Boat System Management, Submarine Chaser Control, ...
#     navigation                 1   Navigation
#     scanning                   1   Scanning
#     engineering                4   Maintenance, Energy Shields, Damage Control, ...
#     weaponry                   4   Ballistic Weapon, Energy Weapon, Missiles, ...
#     fleet_command              6   Formation Drill, Attacking Formation, Defensive Formation, ...
#   STATION_MANAGEMENT  (6)
#     science                    1   Science
#     facility_management        5   Planetary Resource Production, Planetary Production Management, Material Refinement Management, ...
#   DEEP_SPACE_MINING  (4)
#     mining_operations          4   Mining Equipment Operation, Advanced Mining Equipment Operation, Mining Effectiveness, ...
#   INTERACTION_TRADE  (2)
#     commerce                   2   Trade, Union Management
#
# STAT VOCABULARY -- an effect or penalty may only target a stat from
# tools/stat_vocabulary.py ALL_STATS (SHIP_STATS, shared with modules, plus
# SKILL_STATS, which have no hull field and so are skill-only).
#
# SP LADDER -- rank 1, SP_K = 2.16012. Multiply by rank for any other skill.
#
#     level   per level   cumulative    hours @ 1800
#         1         250          250             0.1
#         2         540          790             0.4
#         3       1,167        1,957             1.1
#         4       2,520        4,477             2.5
#         5       5,443        9,920             5.5   <- operate gate
#         6      11,758       21,678            12.0
#         7      25,398       47,076            26.2
#         8      54,864      101,940            56.6
#         9     118,512      220,452           122.5
#        10     256,000      476,452           264.7
#
# HULL TREE -- rooted at skl_fund_spaceship_command; each hull names one predecessor.
#
#     Corvette  (rank 1)
#       Destroyer Escort  (rank 1)
#         Anti-Aircraft Cruiser  (rank 2)
#         Coastal Defence Ship  (rank 2)
#           Monitor  (rank 2)
#             Panzerschiff  (rank 3)
#         Destroyer  (rank 2)
#           Light Cruiser  (rank 3)
#             Heavy Cruiser  (rank 3)
#               Battlecruiser  (rank 4)
#                 Battleship  (rank 5)
#             Light Carrier  (rank 3)
#               Escort Carrier  (rank 3)
#                 Fleet Aircraft Carrier  (rank 4)
#           Merchant Raider  (rank 3)
#       Sloop / Patrol Escort  (rank 1)
#         Minelayer / Sweeper  (rank 2)
#       Landing Ship Tank  (rank 2)
#         Attack Transport  (rank 3)
#           Fleet Oiler  (rank 4)
#         Repair Ship / Tender  (rank 3)
#         Seaplane Tender  (rank 3)
#     Motor Torpedo Boat  (rank 1)
#       Fleet Torpedo Boat  (rank 1)
#     Submarine Chaser  (rank 1)
#       Submarine  (rank 2)
# >>> end generated
#
# INVARIANTS (enforced by tools/verify_skills.py)
#   - skillIds and names unique; field set identical to the schema below
#   - domain, category, scope, unlock type and appliesTo keys all from the closed
#     vocabularies above; category belongs to its domain
#   - maxLevel is 10 everywhere; rank in 1..5
#   - every effect/penalty stat is in tools/stat_vocabulary.py ALL_STATS
#   - appliesFromLevel in 1..maxLevel; appliesBelowLevel in 2..maxLevel
#   - every penalty's stat is also covered by an effect on the same skill, and the
#     effect starts at or after the penalty's threshold -- a stat cannot be debuffed
#     with no path out of the debuff
#   - appliesTo.weaponClass resolves to a weaponClass in the weapon catalogue (or the
#     documented hangar-launched 'drone'); appliesTo.shipCategory to a real category;
#     appliesTo.resourceTier to a real resource tier
#   - every prerequisite skillId resolves, names a different skill, requires a level in
#     1..maxLevel, and the prerequisite graph is acyclic
#   - training.spPerLevel has maxLevel entries, is strictly increasing, and matches the
#     closed form rank * 250 * k ** (level - 1) exactly
#   - training.spCumulative is the running sum of spPerLevel; spTotal is its last entry
#   - the rank-1 curve hits EVE's own endpoints: 250 at level 1, 256,000 at level 10
#   - every hull skill has exactly one hull-tree prerequisite, at OPERATE_LEVEL for a
#     predecessor hull or level 1 for the root
#   - no hull predecessor outranks its successor; the hull tree is acyclic and every
#     one of the 26 categories reaches the root
#   - the two ladders never cross: a Control skill's hull prerequisite is a Control
#     skill, a System Management skill's is a System Management skill
#   - unlock levels within 1..maxLevel and strictly increasing within a skill
#   - exactly 2 ship_operation claimants per category, all 26 categories covered, both
#     at the same level
#   - fleet_slot targets are exactly 2,3,4,5 -- each claimed once
#   - refineryYield at max level cannot push any lane's conversionYield to 1.0 or above
#   - one file on disk per skill, content byte-identical to the fleet json entry,
#     filed under <domain>/<category>/

{
  "skillId": "string, unique, format: skl_<group>_<slug> (group: fund|ship|nav|scan|eng|wpn|flt|sta|mine|trd)",
  "name": "string, unique",
  "domain": "enum: ship_command | station_management | deep_space_mining | interaction_trade",
  "category": "string -- sub-group within the domain; see CATEGORY_ORDER in skill_tables.py",
  "maxLevel": "int, always 10",
  "rank": "int 1-5 -- training-difficulty multiplier; multiplies every SP figure below",
  "training": {
    "spPerLevel": "int[10] -- SP to buy each level, already multiplied by rank",
    "spCumulative": "int[10] -- running sum; SP spent to have REACHED each level",
    "spTotal": "int -- spCumulative[9], the cost of the skill at level 10"
  },
  "scope": "enum: ship | fleet | station | player -- what the effects apply to",
  "effects": [
    {
      "stat": "string, one of tools/stat_vocabulary.py ALL_STATS",
      "modifierPerLevel": "number -- contribution of each qualifying level",
      "modifierType": "enum: percent | flat",
      "appliesFromLevel": "int 1..maxLevel -- first level that contributes",
      "appliesTo": "object -- optional qualifiers: weaponClass, shipCategory, resourceTier"
    }
  ],
  "penalties": [
    {
      "stat": "string, one of tools/stat_vocabulary.py ALL_STATS",
      "modifier": "number -- flat malus, not per-level",
      "modifierType": "enum: percent | flat",
      "appliesBelowLevel": "int 2..maxLevel -- malus applies while level is under this",
      "appliesTo": "object -- same qualifier keys as an effect"
    }
  ],
  "unlocks": [
    {
      "level": "int 1..maxLevel",
      "type": "enum: ship_operation | fleet_slot | capability | skill_group",
      "target": "string -- ship category, fleet slot number, capability key or skill-group key",
      "description": "string"
    }
  ],
  "prerequisites": [
    { "skillId": "string -- another skill in this catalogue", "level": "int 1..maxLevel" }
  ],
  "description": "string"
}

