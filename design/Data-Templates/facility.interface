# INTERFACE: Facility
# Source of truth : ../tools/gameplay_tables.py -> PLANET_ARCHETYPES, slot sizes, LEASE_RATE
# Spec            : ../GamePlay/industry_specification.md
# Generated by    : ../tools/generate_facilities.py -- deterministic, no RNG.
# Live reference  : ../fleet_and_weapons.json -> "facilityTypes"
#                   ../tools/verify_facilities.py checks the invariants below.
#
# [+] No upstream counterpart; new in full.
#
# TWO SHAPES, because this layer has an authored half and a runtime half:
#
#   facilityType   GENERATED. One row per (archetype, developmentTier), holding the
#                  slot counts, per-slot throughput and rent. Pure function of the
#                  archetype table; 30 rows.
#   lease          RUNTIME. One player's claim on one slot on one planet. Created by
#                  play, never generated. Names one of the map's 180 planets.
#
# THE ARCHETYPE TABLE is owned by tools/system_tables.py and imported, never copied.
#
# THE SUBDIVISION preserves totals exactly:
#     slotCount      = max(1, round(archetypeCapacity / SLOT_SIZE))
#     slotThroughput = archetypeCapacity / slotCount
# so slotCount x slotThroughput reproduces the capacity published in
# systems_planets_specification.md 4. Extraction is one slot per lane per planet.
#
# THE TWO LADDERS: richnessTier scales extraction output only; developmentTier
# scales per-slot throughput for refinery, manufactory, shipyard and warehouse --
# and NEVER slot count. Scarcity is a property of the archetype, quality a property
# of development.
#
# WHAT A LEASE MAY NOT TOUCH: yield. A lease scales THROUGHPUT (how much a slot
# processes) and never YIELD (the fraction that survives). Systems_Planets 6.1
# leaves a margin of 0.01 on conversionYield x yieldModifier x refineryYield;
# adding a fourth term would break an invariant three other specs depend on.
#
# siteType admits "planet" and "orbital" today. Deep-space stations are deferred by
# GamePlay/PlayerSpecific ("later stage of the game, not designed yet") and will add
# "deep_space" to this enum without any other schema change.
#
# INVARIANTS (enforced by tools/verify_facilities.py)
#   - slotCount x slotThroughput equals the archetype's published capacity
#   - slotCount >= 1 wherever capacity > 0, and 0 where capacity is 0
#   - developmentTier changes throughput and leaves slotCount fixed
#   - a zero-berth archetype has zero shipyard slots and zero maxHullTonnage
#   - rent is > 0, < the slot's gross output value, and rises with developmentTier
#   - the refining product stays strictly below 1.0 across every lane x archetype

{
  "facilityType": {
    "archetype": "enum: the 10 planet archetypes in systems_planets_specification.md 4",
    "developmentTier": "integer 1-3",
    "securityTiers": "array of enum core | mid | rim | deadspace -- where this archetype may appear",
    "slots": "object: slotKey -> slot row. slotKey is 'extraction.<lane>' or the facilityType name",
    "slots.<key>.facilityType": "enum: extraction | refinery | manufactory | shipyard | warehouse",
    "slots.<key>.lane": "enum: structural | energy | ordnance | precision -- extraction slots only",
    "slots.<key>.slotCount": "integer -- how many independent leases this archetype supports",
    "slots.<key>.throughputPerTurn": "number -- per slot, at this developmentTier",
    "slots.<key>.capacity": "number -- warehouse slots only, in units",
    "slots.<key>.yieldModifier": "number <= 1.00 -- refinery slots only; scales with NEITHER ladder",
    "slots.<key>.maxHullTonnage": "number -- shipyard slots only",
    "slots.<key>.scalesWith": "enum: richnessTier | developmentTier",
    "slots.<key>.unit": "string -- what throughputPerTurn counts",
    "slots.<key>.rentPerTurn": "number, credits, charged in phase 12"
  },

  "lease": {
    "leaseId": "string, unique",
    "playerId": "playerId or unionId -- unions hold ordinary leases",
    "siteType": "enum: planet | orbital   ([+] deep_space reserved, not yet in use)",
    "planetId": "planetId -- one of the 180 planets tools/generate_systems.py writes",
    "facilityType": "enum: extraction | refinery | manufactory | shipyard | warehouse",
    "lane": "enum or null -- extraction leases only",
    "slotIndex": "integer 0..slotCount-1 -- which slot on that planet",
    "startedTurn": "integer",
    "rentPaidThroughTurn": "integer -- unpaid rent ends the lease at the end of phase 12",
    "freeUntilTurn": "integer or null -- the new-player grant, 20 turns",
    "currentJob": "object or null -- { operation, input, quantity }; a standing order"
  }
}

# ---- EXAMPLE INSTANCES ----
#
# facilityType:
# { "archetype": "forge_world", "developmentTier": 3, "securityTiers": ["core", "mid"],
#   "slots": { "shipyard": { "facilityType": "shipyard", "slotCount": 4,
#                            "throughputPerTurn": 45.0, "maxHullTonnage": 81600.0,
#                            "scalesWith": "developmentTier",
#                            "unit": "manufactured units/turn", "rentPerTurn": 218.11 } } }
#
# lease:
# { "leaseId": "lse_0099", "playerId": "ply_0031", "siteType": "planet",
#   "planetId": "pln_014", "facilityType": "refinery", "lane": null, "slotIndex": 2,
#   "startedTurn": 6, "rentPaidThroughTurn": 47, "freeUntilTurn": null,
#   "currentJob": { "operation": "refine", "input": "res_raw_ferrite", "quantity": 500 } }
