# INTERFACE: Weapon
# Source of truth : ../data-template.json -> "weaponSchema"
# Live reference  : ../fleet_and_weapons.json -> "weapons"
# Generated by    : ../tools/generate_weapons.py -- deterministic, no RNG. Re-running
#                   reproduces the catalogue byte-for-byte, so edit the tables in that
#                   script, never the generated files. ../tools/verify_weapons.py checks
#                   the invariants below.
# Usage           : one JSON file per weapon under Weapons/<class>/<size>/;
#                   Weapons/index.json lists every weapon with its path. A ship references
#                   one by weaponId from hardpoints.list[].weaponEquipped (see ship.interface)
#
# NOTATION
#   "string" / "number"   value type
#   "enum: a | b | c"     exactly one of the listed literals
#   "number 0-1"          normalised fraction, not a percentage
#
# SIZE vs HARDPOINT
#   A weapon may only be mounted on a hardpoint of the SAME size.
#
# DIFFERENTIATION MODEL
#   stat = size anchor  x  archetype signature  x  mark ladder  x  family bias
#
#   archetype  the tactical role -- sets the SHAPE of the stat block and its effects
#   size       sets the absolute band, and which hardpoints can take it
#   mark 1-5   a strict power ladder: ~+13% damage per mark (1.63x over Mk.1 -> Mk.5) with
#              power cost rising more slowly, so higher marks are stronger AND more
#              efficient. Marks also step capability, not just numbers: a second
#              specialEffect unlocks at Mk.3 (Mk.2 for Ashwright), and Mk.5 tightens
#              variance and sheds one cooldown turn on sustained-fire weapons.
#   family     manufacturer bias, trade-neutral -- every gain is paid for somewhere.
#              Vanguard is the neutral reference line the others are measured against.
#
# INVARIANTS (enforced by tools/verify_weapons.py)
#   - weaponIds and names unique; field set identical to the schema below
#   - every mark ladder monotonic in damage-per-turn, hit chance and effects
#   - no two weapons share a stat block
#   - no weapon is strictly dominated by a same-class, same-size, SAME-MARK rival at
#     equal-or-lower power cost. Cross-mark domination is intended: the ladder exists so
#     tier-3 ships can outgun tier-1 ones.
#
# <<< generated from tools/generate_weapons.py -- do not edit by hand
# ARCHETYPES -- the role signature. "sizes" are the hardpoint sizes it is built in.
#
#   archetype                class    sizes                         n  families
#   Autocannon               kinetic  small/medium                 27  Kestrel, Vanguard
#   AA Autocannon            kinetic  small/medium                 30  Vanguard, Kestrel, Meridian
#   Chain Gun                kinetic  small                        17  Kestrel, Obsidian, Vanguard
#   PD Autocannon            kinetic  small                        19  Halcyon, Meridian, Vanguard
#   Flak Cannon              kinetic  small/medium                 23  Vanguard, Ceridan
#   Coilgun                  kinetic  small/medium                 26  Ceridan, Voss
#   Gauss Cannon             kinetic  large/capital                28  Draconis, Solari
#   Mass Driver              kinetic  medium/large                 28  Draconis, Ashwright
#   Railgun                  kinetic  medium/large                 34  Voss, Solari, Halcyon
#   Pulse Laser              energy   small/medium                 24  Halcyon, Vanguard
#   PD Laser Turret          energy   small                        17  Halcyon, Meridian, Solari
#   Beam Laser               energy   medium/large                 29  Voss, Halcyon
#   Disruptor Beam           energy   small/medium                 27  Ashwright, Obsidian
#   Ion Cannon               energy   medium/large/capital         57  Draconis, Ashwright, Solari
#   Plasma Cannon            energy   large/capital                29  Draconis, Ashwright
#   Proton Blaster           energy   medium/large                 28  Solari, Kestrel
#   Particle Lance           energy   large/capital                24  Draconis, Voss
#   Arc Projector            energy   small/medium                 20  Obsidian, Meridian
#   Seeker Missile           missile  small/medium                 22  Halcyon, Ceridan
#   Missile Rack             missile  small/medium                 26  Kestrel, Ceridan
#   Swarm Missile Pod        missile  small/medium                 27  Kestrel, Obsidian
#   Torpedo Launcher         missile  medium/large                 33  Draconis, Vanguard, Meridian
#   Cruise Missile Bay       missile  large/capital                29  Voss, Ashwright
#   Interceptor Missile      missile  small/medium                 20  Halcyon, Meridian
#   Mine Layer               mine     medium/large                 27  Ceridan, Meridian
#   Proximity Mine Dispenser mine     small/medium                 27  Obsidian, Ceridan
#   Depth Charge Rack        mine     small/medium                 20  Vanguard, Kestrel
#   Siege Mine Cluster       mine     large/capital                20  Ashwright, Draconis
#   Boarding Ram             melee    medium/large                 20  Draconis, Vanguard
#   Grapple Harpoon          melee    small/medium                 20  Kestrel, Meridian
#   Siege Drill              melee    large/capital                20  Ashwright, Draconis
#
# FAMILIES -- manufacturer bias, applied on top of the archetype signature.
#   x1.00 / +0.00 means that family leaves the stat at the reference value.
#
#   family       dmg   rof   cd   trk    hit   rng   pwr  crit   var  ammo   n
#   Vanguard    1.00  1.00   +0  1.00  +0.00  1.00  1.00  1.00  1.00  1.00   96
#   Ashwright   0.97  1.00   +0  1.00  +0.00  1.02  1.15  1.35  1.00  1.00   88
#   Ceridan     0.92  1.00   -1  1.00  +0.00  0.95  1.05  0.95  1.00  1.60   70
#   Draconis    1.30  1.00   +0  0.85  -0.07  1.05  1.20  1.10  1.15  0.85  108
#   Halcyon     0.85  1.00   +0  1.30  +0.07  1.00  1.00  0.95  0.90  1.00   76
#   Kestrel     0.72  1.50   +0  1.05  +0.00  0.92  1.05  0.90  1.00  1.25   88
#   Meridian    0.93  1.00   +0  1.15  +0.02  1.00  1.00  0.85  0.45  1.00   87
#   Obsidian    0.95  1.00   +0  0.95  -0.02  0.98  0.98  1.60  1.70  1.00   62
#   Solari      0.90  1.00   +0  1.00  +0.00  1.00  0.70  0.95  1.00  1.00   61
#   Voss        1.05  0.70   +1  0.90  +0.00  1.45  1.10  1.05  1.00  0.90   62
#
#   Ceridan sustain (+ammo, -cooldown) is inert on an infinite-ammo, no-cooldown
#   weapon; there it re-expresses as +1 shot per turn, so a Ceridan line is never
#   just a worse Vanguard. Ashwright "effect potency" unlocks its second
#   specialEffect at Mk.2 instead of Mk.3.
# >>> end generated
#
# specialEffects VOCABULARY
#   anti_air (new)      anti_missile     area_denial       armor_melt
#   armor_piercing      can_be_intercepted                 emp_disable
#   high_tracking       ignores_shields_partial            multi_hit
#   point_defense       proximity_trigger                  shield_disrupt
#   Resolved by combatResolution.damageFormula.specialEffectOverrides in data-template.json:
#     ignores_shields_partial -> 50% of rawDamage bypasses shields straight to hull
#     armor_piercing          -> hull.armorRating is halved when computing hull damage

{
  "weaponId": "string, unique, format: wpn_<nnn>",
  "name": "string",
  "weaponClass": "enum: kinetic | energy | missile | mine | melee",
  "size": "enum: small | medium | large | capital",
  "damage": {
    "base": "number",
    "variance": "number, +/- random spread applied per shot",
    "damageType": "enum: kinetic | energy | explosive"
  },
  "range": {
    "optimal": "number",
    "maximum": "number, beyond this 0 hit chance",
    "falloffPenalty": "number 0-1 per unit beyond optimal"
  },
  "accuracy": {
    "baseHitChance": "number 0-1",
    "tracking": "number, ability to hit fast/small targets"
  },
  "fireRate": {
    "shotsPerTurn": "number",
    "cooldownTurns": "number after volley before it can fire again"
  },
  "powerCost": "number, drawn from ship power pool per shot",
  "ammo": "number or 'infinite', for missiles/kinetics with physical rounds",
  "criticalChance": "number 0-1, chance to roll on component-critical table",
  "specialEffects": [
    "array of strings, e.g. 'ignores_shields', 'emp_disable', 'armor_piercing'"
  ],
  "buildCost": {
    "structural": "number, manufactured-tier Structural Component units",
    "energy": "number, manufactured-tier Power Core Unit units",
    "ordnance": "number, manufactured-tier Ordnance Charge units",
    "precision": "number, manufactured-tier Guidance Assembly units"
  }
}

