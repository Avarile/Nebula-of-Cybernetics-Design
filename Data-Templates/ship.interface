# Each Ship Category(for example Heavy Cruiser) will have 3 tiers, tier 1 is basic, tier 2 is advanced, tier 3 is premium(best)
#
# INTERFACE: Ship
# Source of truth : ../data-template.json -> "shipSchema"
# Live reference  : ../fleet_and_weapons.json -> "ships"
# Generated by    : ../tools/generate_ships.py (signatures in ../tools/ship_tables.py) --
#                   deterministic, no RNG. ../tools/verify_ships.py checks the invariants.
# Usage           : one directory per tier inside Ships/<Category>/ --
#                     Ships/Heavy cruiser/tier-2/ship.json    the hull (this schema)
#                     Ships/Heavy cruiser/tier-2/Weapons/     one file per filled hardpoint
#                     Ships/Heavy cruiser/tier-2/Modules/     one file per filled slot
#                   A fitting file is the full catalogue entry with the mount it occupies
#                   added (hardpointId/mountType, or slotId) plus a `catalogue` path back
#                   to Weapons/<class>/<size>/ or Modules/<slotType>/<functionClass>/.
#                   Named ships sit beside the tier hulls of their own class, same layout:
#                     Ships/Destroyer/Whisperfang/ship.json + Weapons/ + Modules/
#                   A named ship carries `templateId`, naming the tier hull it is an
#                   instance of. Ships/index.json lists both, tagged kind template|named.
#
# NOTATION
#   "string" / "number"   value type
#   "enum: a | b | c"     exactly one of the listed literals
#   "<x> or null"         nullable
#   current* fields start equal to their max* counterpart on a newly built ship
#
# EXTENSIONS BEYOND data-template.json (marked [+] below)
#   tier       - required by the tier rule at the top of this file
#   shipClass  - single flat enum of the 26 categories in Ships/. It replaces BOTH the broad
#                shipSchema enum (scout | frigate | cruiser | battleship | carrier | freighter)
#                and the separate shipSubClass field used in fleet_and_weapons.json.
#   sensors     - detectionRange and initiative. Module effects target these; without
#                 them a Search Radar or Datalink Relay would modify nothing.
#   capacities  - what the hull can hold: cargo, ammo, fuel, troops, aircraft, drones,
#                 mines, medical, repairRate. Most read 0 -- a battleship carries no
#                 troops -- which is what makes a `specific` module specific.
#   moduleSlots.list[].size     - the module size the slot accepts, mirroring hardpoints
#   moduleSlots.list[].slotType - enum extended with `command` (CIC tower, flag bridge) and
#                `hangar` (drone controller, catapult, aircraft elevator). See module.interface.
#
# TIER GUIDANCE (relative to tier 1 of the SAME category)
#   tier 1 basic    baseline hull/shields/power, mass at the low end of the band,
#                   smallest hardpoints, crew skills ~45-60
#   tier 2 advanced +20-35% hull/shield/power, one extra module slot,
#                   mid-band mass, crew skills ~60-75
#   tier 3 premium  +50-75% hull/shield/power over tier 1, largest hardpoints the
#                   band allows, top-band mass, crew skills ~75-90
#
# shipClass MASS BANDS -> mass.value, unit "tons" (one folder per row in Ships/)
#   motor_torpedo_boat            30 -    115
#   submarine_chaser              95 -    450
#   corvette                     925 -  1,100
#   torpedo_boat_fleet           600 -  1,700
#   destroyer_escort           1,100 -  1,900
#   sloop_patrol_escort        1,250 -  1,900
#   destroyer                  1,300 -  3,600
#   landing_ship_tank          3,800 -  4,100
#   submarine                    500 -  5,200
#   minelayer_sweeper            600 -  7,000
#   coastal_defence_ship       3,600 -  8,000
#   anti_aircraft_cruiser      5,400 -  8,000
#   monitor                    7,200 -  9,200
#   light_cruiser              5,000 - 14,000
#   attack_transport           8,000 - 14,000
#   light_carrier             11,000 - 15,000
#   panzerschiff              12,000 - 16,000
#   merchant_raider            7,000 - 17,000
#   seaplane_tender            8,000 - 17,000
#   repair_ship_tender         8,000 - 17,000
#   heavy_cruiser              9,000 - 17,000
#   escort_carrier             7,800 - 24,000
#   fleet_oiler               16,000 - 25,000
#   fleet_aircraft_carrier    13,000 - 45,000
#   battlecruiser             32,000 - 47,000
#   battleship                26,000 - 72,000

{
  "shipId": "string, unique, format: ship_<shipClass>_<name_lowercase>_t<tier>",
  "name": "string",
  "tier": "[+] number: 1 | 2 | 3, 1 = basic, 2 = advanced, 3 = premium",
  "shipClass": "[+] enum: motor_torpedo_boat | submarine_chaser | corvette | torpedo_boat_fleet | destroyer_escort | sloop_patrol_escort | destroyer | landing_ship_tank | submarine | minelayer_sweeper | coastal_defence_ship | anti_aircraft_cruiser | monitor | light_cruiser | attack_transport | light_carrier | panzerschiff | merchant_raider | seaplane_tender | repair_ship_tender | heavy_cruiser | escort_carrier | fleet_oiler | fleet_aircraft_carrier | battlecruiser | battleship",
  "mass": {
    "value": "number, must fall inside the category mass band listed above",
    "unit": "tons",
    "note": "Affects acceleration, turn rate, and weapon slot capacity limits"
  },
  "hull": {
    "maxHP": "number",
    "currentHP": "number",
    "armorRating": "number, flat damage reduction applied after shields are down",
    "armorType": "enum: light | medium | heavy | reactive"
  },
  "shields": {
    "maxHP": "number",
    "currentHP": "number",
    "rechargeRatePerTurn": "number",
    "rechargeDelayAfterHit": "number, turns before recharge resumes",
    "shieldType": "enum: kinetic | energy | hybrid | none",
    "damageTypeResistance": {
      "kinetic": "number 0-1, percent reduction",
      "energy": "number 0-1",
      "explosive": "number 0-1"
    }
  },
  "hardpoints": {
    "description": "Weapon mounting slots. Count and size scale with shipClass/mass.",
    "list": [
      {
        "hardpointId": "string, format: hp_<n>",
        "size": "enum: small | medium | large | capital",
        "mountType": "enum: fixed | turret | missile_bay",
        "weaponEquipped": "weaponId (see weapon.interface) or null"
      }
    ]
  },
  "moduleSlots": {
    "description": "Non-weapon systems: engines, shield boosters, ECM, repair drones, cargo, etc.",
    "list": [
      {
        "slotId": "string, format: ms_<n>",
        "slotType": "[+] enum: engine | utility | defensive | sensor | cargo | command | hangar",
        "size": "[+] enum: small | medium | large | capital, must equal the module's size",
        "moduleEquipped": "moduleId (see module.interface) or null"
      }
    ]
  },
  "componentHitpoints": {
    "description": "Subsystems that can be targeted/critically hit independently of overall hull HP.",
    "bridge": {
      "maxHP": "number",
      "currentHP": "number",
      "criticalEffect": "disables targeting computer, -50% accuracy"
    },
    "engines": {
      "maxHP": "number",
      "currentHP": "number",
      "criticalEffect": "-70% speed and turn rate"
    },
    "weaponSystems": {
      "maxHP": "number",
      "currentHP": "number",
      "criticalEffect": "random hardpoint disabled"
    },
    "shieldGenerator": {
      "maxHP": "number",
      "currentHP": "number",
      "criticalEffect": "shield recharge disabled"
    },
    "sensorArray": {
      "maxHP": "number",
      "currentHP": "number",
      "criticalEffect": "-40% hit chance, reduced detection range"
    },
    "lifeSupport": {
      "maxHP": "number",
      "currentHP": "number",
      "criticalEffect": "crew casualties over time"
    }
  },
  "mobility": {
    "topSpeed": "number, units/sec",
    "acceleration": "number, units/sec^2",
    "turnRate": "number, degrees/sec",
    "evasionRating": "number 0-1, base chance to avoid being hit, scales inversely with mass"
  },
  "crew": {
    "maxCrew": "number",
    "currentCrew": "number",
    "pilotSkill": "number 0-100, affects accuracy and evasion",
    "gunnerySkill": "number 0-100, affects weapon accuracy and fire rate",
    "engineeringSkill": "number 0-100, affects repair speed and power management"
  },
  "power": {
    "maxPower": "number, must cover passive module draw plus one full weapon volley",
    "currentPower": "number",
    "regenPerTurn": "number",
    "note": "Weapons/shields/engines draw power; allocation can be shifted between them each turn"
  },
  "sensors": {
    "detectionRange": "[+] number, units",
    "initiative": "[+] number, added to the initiative roll"
  },
  "capacities": {
    "cargo": "[+] number, tons",
    "ammo": "[+] number, rounds",
    "fuel": "[+] number, tons",
    "troops": "[+] number, embarked personnel",
    "aircraft": "[+] number, airframes",
    "drones": "[+] number",
    "mines": "[+] number",
    "medical": "[+] number, casualty berths",
    "repairRate": "[+] number, hull points repaired per turn to a docked ship"
  }
}

